# W5CDN NTS Traffic Manager Configuration
# Shared suite config lives at:
#   Windows: %APPDATA%\W5CDN\shared\config.txt
#   Linux:   ~/.config/W5CDN/shared/config.txt
# (You can also configure all of these inside the app under Preferences.)

# Default operator callsign
OPERATOR_CALL=W5CDN

# Optional QRZ.com XML Logbook Data credentials (falls back to Callook.info)
QRZ_USER=
QRZ_PASS=

# Optional LinBPQ / BPQ32 Telnet password override
# BPQ_PASS=

# Optional directory overrides (default uses shared W5CDN suite layout)
# W5CDN_SUITE_DIR=
# NTS_TRAFFIC_DATA_DIR=
# RADIOGRAMS_DIR=
# OUTBOX_DIR=
